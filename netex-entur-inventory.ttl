## -----------------------------------------------------------------
## Inventory Service Sub-Profile
## -----------------------------------------------------------------
## ROLE: Describes the NeTEx dependencies for Entur's Inventory service
##       (internally "Varelager"). Inventory manages quotas — a quota
##       is a limit on the number of instances of something that can be
##       reserved at once. A quota usually has a geographic component
##       and is ALWAYS associated with a particular departure
##       (developer.entur.org/pages-inventory-intro). A quota is an
##       Inventory/Entur construct, not a native NeTEx object. This
##       profile pins only its NeTEx touchpoints: the departure it is
##       anchored to and the ordered stop sequence it is allocated
##       across.
##
## DESIGN INTENT — INDEPENDENCE FROM ROLLING STOCK:
##       A quota applies to a departure (DatedServiceJourney) and its
##       ordered stops, and does NOT require vehicle/materiel data.
##       Quotas are used on departures WITHOUT rolling stock
##       composition too. This sub-profile is therefore a PEER of
##       rolling stock — it never imports it, and an Inventory delivery
##       is validated against these shapes ONLY, never against the
##       stricter rolling stock shapes (e.g. the mandatory BlockRef in
##       RS_DatedServiceJourneyShape).
##
## Imports: netex-entur.ttl (Entur governance + codespaces)
##          → netex-nordic.ttl → generated NeTEx base (netex:) + nordic vocab
##
## Generated: 2026-08-12
## -----------------------------------------------------------------

@prefix netex:   <https://netex-cen.eu/ontology#> .
@prefix profile: <https://netex-cen.eu/profile#> .
@prefix entur:   <https://entur.org/ontology#> .
@prefix inv:     <https://entur.org/service/inventory#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

## --- Import Entur governance ---
<https://entur.org/service/inventory> a owl:Ontology ;
    owl:imports <https://entur.org/ontology> .

## =================================================================
## SERVICE DEFINITION
## =================================================================

inv:InventoryService a entur:SubProfile ;
    rdfs:label "Inventory — Inventory Service Profile" ;
    skos:definition "Sub-profile for the Inventory service (Varelager): quota allocation across a departure and its ordered stops. A quota is a limit on reservable instances, tied to a departure; an Inventory construct, not a native NeTEx object; independent of rolling stock composition." ;
    entur:basedOn profile:NP ;
    inv:independentOf <https://entur.org/service/rolling-stock> ;
    inv:requiresVehicleData false .

## =================================================================
## CONSUMED REFERENCES (reads from operator deliveries)
## =================================================================
## A quota is anchored to a departure and the ordered stop sequence it
## is allocated across. It deliberately reads NO train composition.
## -----------------------------------------------------------------

inv:InventoryService inv:consumes
    ## --- Departure anchor ---
    netex:datedServiceJourneyRef ,
    netex:serviceJourneyRef ,
    netex:lineRef ,
    ## --- Ordered stop sequence along the departure ---
    netex:pointsInSequence ,
    netex:stopPointInJourneyPatternRef ,
    netex:scheduledStopPointRef ,
    netex:order .

## =================================================================
## OBJECTS IN SCOPE
## =================================================================
## The NeTEx touchpoints a quota references: the departure and its
## ordered stops. No Train / CompoundTrain / TrainElement — a quota
## needs the stop sequence, not materiel. That is the point.
## -----------------------------------------------------------------

inv:InventoryService inv:requiresClass
    netex:DatedServiceJourney ,
    netex:ServiceJourney ,
    netex:JourneyPattern ,
    netex:StopPointInJourneyPattern ,
    netex:ScheduledStopPoint ,
    netex:Line .

## =================================================================
## SERVICE-SPECIFIC CONSTRAINTS — SHACL SHAPES
## =================================================================
## Shape naming: inv:INV_{ClassName}Shape
##
## KEY DIFFERENCE vs rolling stock: this shape targets the SAME class
## (DatedServiceJourney) but does NOT require BlockRef or any materiel.
## A departure without rolling stock can still carry a valid quota.
## -----------------------------------------------------------------

inv:INV_DatedServiceJourneyShape a sh:NodeShape ;
    sh:targetClass netex:DatedServiceJourney ;
    rdfs:label "DatedServiceJourney — Inventory constraints" ;
    ## No sh:property for netex:blockRef — intentionally unconstrained.
    ## A quota must not force a departure to have a train block.
    sh:property [
        sh:path netex:operatingDayRef ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class netex:OperatingDay ;
        sh:name "OperatingDayRef" ;
        sh:description "The quota is bound to a concrete operating day"
    ] .

## The ordered stop sequence the quota is allocated across.
inv:INV_StopPointInJourneyPatternShape a sh:NodeShape ;
    sh:targetClass netex:StopPointInJourneyPattern ;
    rdfs:label "StopPointInJourneyPattern — Inventory ordering" ;
    sh:property [
        sh:path netex:order ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:name "Order" ;
        sh:description "Position in the stop sequence; the quota is allocated per leg between ordered stops"
    ] .

## PROPOSAL: "Quota" is an Inventory/Entur (Varelager) construct and may
## not be a native NeTEx class. This profile pins only the NeTEx
## touchpoints a quota references — the departure (DatedServiceJourney)
## and its ordered stop sequence. The allocation quantity/segment model
## lives in Inventory, not NeTEx. Confirm the property IRIs (order,
## stopPointInJourneyPatternRef) against the generated base.

## =================================================================
## END OF INVENTORY SERVICE PROFILE
## =================================================================
