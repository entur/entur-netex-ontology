## Entur-scoped replacement for the shared nordic:OrganisationChain, which
## referenced netex:Contract (not in the Nordic allowlist) and does not belong in the shared
## Nordic repo. Dropped from netex-nordic.ttl upstream; owned here instead.
entur:step1 a owl:ObjectProperty ; rdfs:label "step1" .
entur:step2 a owl:ObjectProperty ; rdfs:label "step2" .
entur:step3 a owl:ObjectProperty ; rdfs:label "step3" .
entur:step4 a owl:ObjectProperty ; rdfs:label "step4" .

entur:OrganisationChain rdfs:comment """
    Authority → Contract → Operator → ResponsibilitySet
    Organisational governance and responsibility.
""" ;
    entur:step1 netex:Authority ;
    entur:step2 netex:Contract ;
    entur:step3 netex:Operator ;
    entur:step4 netex:ResponsibilitySet .

## Structural delivery classes still missing from the Nordic allowlist.
## Nordic frame classes are inherited and are not repeated here.
netex:PublicationDelivery profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:ParticipantRef profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:TrainComponent profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:TrainInCompoundTrain_VersionedChildStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .

## Generated containment wrappers for the delivery and frame contents.
## Names ending in _RelStructure are NeTEx classes, not properties; they
## carry the XML list/containment semantics for properties such as
## netex:stopPlaces and netex:dataObjects.
netex:dataObjects_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:frames_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:topographicPlaces_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:quays_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:stopPlaces_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:scheduledStopPointsInFrame_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:stopPlacesInFrame_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:trainComponents_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:blockParts_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:journeysInFrame_RelStructure profile:scope profile:Entur ;
    entur:provenance entur:Baseline .

## =================================================================
## META-CLASSES (entur vocabulary)
## =================================================================

entur:System a owl:Class ;
    rdfs:label "System" ;
    skos:definition "An Entur platform or application managing NeTEx data" .

entur:PartnerModule a owl:Class ;
    rdfs:label "PartnerModule" ;
    skos:definition "A microservice module within the Entur Partner portal" .

## SubProfile and basedOn are Entur concepts declaring what a specific
## Entur system consumes/produces on top of the Nordic Profile.
entur:SubProfile a owl:Class ;
    rdfs:label "SubProfile" ;
    skos:definition "A service-scoped subset of a profile, declaring what a specific Entur system consumes/produces" .

entur:basedOn a owl:ObjectProperty ;
    rdfs:label "basedOn" ;
    skos:definition "Relates an Entur sub-profile to the Nordic Profile it constrains further" .

## DatedServiceJourney is an Entur implementation concern, not a shared
## Nordic Profile commitment. Keep its common constraints here; service
## profiles may tighten them further (for example with blockRef).
##
## This is a profile/scope relationship, not an RDF type relationship.
## rdfs:subClassOf would assert that one set of NeTEx instances is a
## semantic subtype of another. Entur instead reuses the same NeTEx class
## and applies a stricter validation profile to it.
## =================================================================
## ENTUR PROFILE CONSTRAINTS
## =================================================================

entur:ENT_DatedServiceJourneyShape a sh:NodeShape ;
    sh:targetClass netex:DatedServiceJourney ;
    rdfs:label "DatedServiceJourney — Entur constraints" ;
    sh:property [
        sh:path netex:journeyRef ;
        sh:name "ServiceJourneyRef" ;
        sh:description "Reference to the template journey this dated instance realizes" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path netex:operatingDayRef ;
        sh:name "OperatingDayRef" ;
        sh:description "The specific operating day this journey runs on" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path netex:datedVehicleJourneyRef ;
        sh:name "DatedVehicleJourneyRef" ;
        sh:description "Deviation/replacement tracking used by Entur"
    ] , [
        sh:path netex:serviceAlteration ;
        sh:name "ServiceAlteration" ;
        sh:description "Alteration status code when journey deviates from plan" ;
        sh:maxCount 1 ;
        sh:in ( "planned" "cancellation" "replaced" "extraJourney" )
    ] .

## FareZone is Entur-scoped (not part of the Nordic allowlist). This
## shape replaces the former profile:NP_FareZoneShape, which wrongly lived
## in the shared netex-nordic.ttl.
entur:ENT_FareZoneShape a sh:NodeShape ;
    sh:targetClass netex:FareZone ;
    rdfs:label "FareZone — Entur constraints" ;
    sh:property [
        sh:path netex:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "Name" ;
        sh:description "XSD allows 0..1, Entur mandates 1..1"
    ] .

## =================================================================
## DATA GOVERNANCE
## =================================================================
## In Norway, Entur maintains central registries. Operators produce
## NeTEx deliveries that REFERENCE objects in these registries.
## -----------------------------------------------------------------

entur:CentralRegistry a netex:DataSource ;
    rdfs:label "Central registry (Entur)" ;
    skos:definition "Mastered in Entur's shared national registry. Operators reference these objects by id but do not produce or version them." .

entur:OperatorDelivery a netex:DataSource ;
    rdfs:label "Operator delivery" ;
    skos:definition "Produced by operators in their NeTEx deliveries to Entur. May contain references to central registry objects." .

entur:DerivedInternal a netex:DataSource ;
    rdfs:label "Derived/synthesized internally (Entur)" ;
    skos:definition "Generated by Entur systems from other data (e.g. materializing DatedServiceJourneys for ServiceJourneys that lack explicit dated instances in operator deliveries)." .

## =================================================================
## DATA OWNERSHIP PER CLASS
## =================================================================

## --- Central registries (operators reference these via @ref) ---

netex:StopPlace         entur:dataSource entur:CentralRegistry .
netex:Quay              entur:dataSource entur:CentralRegistry .
netex:TopographicPlace  entur:dataSource entur:CentralRegistry .
netex:Authority         entur:dataSource entur:CentralRegistry .
netex:Operator          entur:dataSource entur:CentralRegistry .
netex:TariffZone        entur:dataSource entur:CentralRegistry .
netex:FareZone          entur:dataSource entur:CentralRegistry .
netex:TrainElement      entur:dataSource entur:CentralRegistry .

## --- Operator-produced data (delivered to Entur) ---

netex:Line               entur:dataSource entur:OperatorDelivery .
netex:Route              entur:dataSource entur:OperatorDelivery .
netex:JourneyPattern     entur:dataSource entur:OperatorDelivery .
netex:ServiceJourney     entur:dataSource entur:OperatorDelivery .
netex:DatedServiceJourney entur:dataSource entur:OperatorDelivery , entur:DerivedInternal ;
    rdfs:comment "Primary source is operator delivery; Entur also synthesizes DatedServiceJourneys internally for ServiceJourneys lacking explicit dated instances." .
netex:DayType            entur:dataSource entur:OperatorDelivery .
netex:DayTypeAssignment  entur:dataSource entur:OperatorDelivery .
netex:OperatingPeriod    entur:dataSource entur:OperatorDelivery .
netex:OperatingDay       entur:dataSource entur:OperatorDelivery .
netex:ScheduledStopPoint entur:dataSource entur:OperatorDelivery .
netex:PassengerStopAssignment entur:dataSource entur:OperatorDelivery .
netex:DestinationDisplay entur:dataSource entur:OperatorDelivery .
netex:Notice             entur:dataSource entur:OperatorDelivery .
netex:GroupOfLines       entur:dataSource entur:OperatorDelivery .
netex:Interchange        entur:dataSource entur:OperatorDelivery .
netex:TrainBlock         entur:dataSource entur:OperatorDelivery .
netex:Vehicle            entur:dataSource entur:OperatorDelivery .
netex:VehicleType        entur:dataSource entur:OperatorDelivery .
netex:Codespace          entur:dataSource entur:OperatorDelivery .
netex:ServiceCalendar    entur:dataSource entur:OperatorDelivery .
netex:RoutePoint         entur:dataSource entur:OperatorDelivery .
netex:ServiceLink        entur:dataSource entur:OperatorDelivery .
netex:SiteConnection     entur:dataSource entur:OperatorDelivery .
netex:TrainNumber        entur:dataSource entur:OperatorDelivery .
netex:CompoundTrain      entur:dataSource entur:OperatorDelivery .
netex:Train              entur:dataSource entur:OperatorDelivery .

## =================================================================
## ENTUR CODESPACE CONVENTIONS
## =================================================================

entur:CodespaceNSR a netex:Codespace ;
    rdfs:label "NSR" ;
    skos:definition "National Stop Registry — stop places, quays, topographic places" ;
    entur:xmlns "NSR" ;
    entur:xmlnsUrl "http://www.rutebanken.org/ns/nsr" ;
    entur:manages netex:StopPlace , netex:Quay , netex:TopographicPlace .

entur:CodespaceNOG a netex:Codespace ;
    rdfs:label "NOG" ;
    skos:definition "National Organisation Registry — authorities and operators" ;
    entur:xmlns "NOG" ;
    entur:xmlnsUrl "http://www.rutebanken.org/ns/nog" ;
    entur:manages netex:Authority , netex:Operator .

entur:CodespacePEN a netex:Codespace ;
    rdfs:label "PEN" ;
    skos:definition "National Rolling Stock Registry — train elements (Plads90 replacement)" ;
    entur:xmlns "PEN" ;
    entur:xmlnsUrl "http://www.rutebanken.org/ns/pen" ;
    entur:manages netex:TrainElement ;
    entur:managedVia entur:PartnerPlass ;
    rdfs:comment "Operators reference PEN:TrainElement from their Train/CompoundTrain compositions" .

## =================================================================
## ENTUR PARTNER PORTAL (microservice modules)
## =================================================================

entur:EnturPartner a entur:System ;
    rdfs:label "Entur Partner" ;
    skos:definition "Umbrella portal for Entur's central management microservices" .

entur:PartnerPlass a entur:PartnerModule ;
    rdfs:label "Plass" ;
    skos:definition "Rolling stock management module (Plads90 replacement)" ;
    entur:partOf entur:EnturPartner ;
    entur:manages netex:CompoundTrain , netex:Train .

entur:PartnerAvstandOgNettverk a entur:PartnerModule ;
    rdfs:label "Avstand og nettverk" ;
    skos:definition "Zones and distances module — manages fare zones with operator codespace, displayed in NSR" ;
    entur:partOf entur:EnturPartner ;
    entur:manages netex:TariffZone , netex:FareZone ;
    rdfs:comment "Operator codespace (e.g. RUT:FareZone:4) but centrally governed" .

entur:PartnerOrganisasjonsregister a entur:PartnerModule ;
    rdfs:label "Organisasjonsregister" ;
    entur:partOf entur:EnturPartner ;
    entur:manages netex:Authority , netex:Operator .

## =================================================================
## END OF ENTUR GOVERNANCE ONTOLOGY
## =================================================================
