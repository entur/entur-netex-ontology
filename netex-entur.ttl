## -----------------------------------------------------------------
## Entur Data Governance Ontology
## -----------------------------------------------------------------
## ROLE: Entur-specific implementation details that deviate from or
##       extend the Nordic Profile. Codespace conventions, central
##       registry ownership, data source assignments, and partner
##       portal modules for Norwegian NeTEx deliveries.
##
## These are Entur's operational choices — not part of the Nordic
## agreement, but necessary for operators delivering data to Entur.
##
## Imports: netex-nordic.ttl (Nordic Profile constraints)
##          → which imports netex.ttl (base NeTEx classes)
##
## Generated: 2026-06-09
## -----------------------------------------------------------------

@prefix netex:   <https://netex-cen.eu/ontology#> .
@prefix entur:   <https://entur.org/ontology#> .
@prefix nordic:  <https://netex-cen.eu/nordic#> .
@prefix profile: <https://netex-cen.eu/profile#> .
@prefix siri:    <https://siri-cen.eu/ontology#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

## --- Import Nordic Profile ---
<https://entur.org/ontology> a owl:Ontology ;
    owl:imports <https://netex-cen.eu/profile/nordic> .

## Entur reuses the Nordic profile through inheritance and declares its
## additional classes as entur:X profile:ProfileClass nodes with
## profile:scope profile:Entur. Nordic does not refer to this downstream
## profile.
profile:Entur a profile:Scope , nordic:Profile ;
    rdfs:label "Entur Profile" ;
    nordic:extendsProfile profile:NP .

## Profile declarations use the shared profile: vocabulary. Each Entur
## class is an Entur-owned profile:ProfileClass node (entur:X) pointing at
## netex:X; nothing here writes profile statements on netex: classes.

entur:Provenance a owl:Class ;
    rdfs:label "Provenance" .

entur:provenance a owl:ObjectProperty ;
    rdfs:label "provenance" ;
    rdfs:range entur:Provenance .

entur:Baseline a entur:Provenance ;
    rdfs:label "Entur baseline" ;
    skos:definition "An initial Entur profile rule not yet tracked to a separate decision" .

## =================================================================
## ENTUR PROFILE CLASSES AND FIELD DEFINITIONS
## =================================================================
## Each entur:X node is Entur's own resource for netex:X and an addition
## to the effective Entur profile on top of the inherited Nordic classes.

## --- CompoundTrain (Entur) ---
entur:CompoundTrain a profile:ProfileClass ;
    profile:onClass netex:CompoundTrain ;
    profile:scope profile:Entur ;
    entur:provenance entur:Baseline .

[] a profile:ProfileMember ;
    profile:memberOf entur:CompoundTrain ;
    profile:element "@id" ;
    profile:path "CompoundTrain/@id" ;
    profile:cardinality "1..1" ;
    entur:provenance entur:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf entur:CompoundTrain ;
    profile:element "@version" ;
    profile:path "CompoundTrain/@version" ;
    profile:cardinality "1..1" ;
    entur:provenance entur:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf entur:CompoundTrain ;
    profile:element "Name" ;
    profile:path "CompoundTrain/Name" ;
    profile:cardinality "0..1" ;
    entur:provenance entur:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf entur:CompoundTrain ;
    profile:element "components" ;
    profile:path "CompoundTrain/components" ;
    profile:cardinality "1..1" ;
    entur:provenance entur:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf entur:CompoundTrain ;
    profile:element "TrainInCompoundTrain/@id" ;
    profile:path "CompoundTrain/components/TrainInCompoundTrain/@id" ;
    profile:cardinality "1..1" ;
    entur:provenance entur:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf entur:CompoundTrain ;
    profile:element "@order" ;
    profile:path "CompoundTrain/components/TrainInCompoundTrain/@order" ;
    profile:cardinality "1..1" ;
    entur:provenance entur:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf entur:CompoundTrain ;
    profile:element "Train@ref" ;
    profile:path "CompoundTrain/components/TrainInCompoundTrain/TrainRef/@ref" ;
    profile:cardinality "1..1" ;
    entur:provenance entur:Baseline .
[] a profile:ProfileMember ;
    profile:memberOf entur:CompoundTrain ;
    profile:element "Label" ;
    profile:path "CompoundTrain/components/TrainInCompoundTrain/Label" ;
    profile:cardinality "0..1" ;
    entur:provenance entur:Baseline .

