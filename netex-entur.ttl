## -----------------------------------------------------------------
## Entur Data Governance Ontology
## -----------------------------------------------------------------
## ROLE: Entur-specific implementation details that deviate from or
##       extend the Nordic Profile. Codespace conventions, central
##       registry ownership, data source assignments, and partner
##       portal modules for Norwegian NeTEx deliveries.
##
## These are Entur's operational choices — not part of the Nordic
## agreement, but necessary for operators delivering data to Entur.
##
## Imports: netex-nordic.ttl (Nordic Profile constraints)
##          → which imports netex.ttl (base NeTEx classes)
##
## Generated: 2026-06-09
## -----------------------------------------------------------------

@prefix netex:   <https://netex-cen.eu/ontology#> .
@prefix entur:   <https://entur.org/ontology#> .
@prefix nordic:  <https://netex-cen.eu/nordic#> .
@prefix profile: <https://netex-cen.eu/profile#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

## --- Import Nordic Profile ---
<https://entur.org/ontology> a owl:Ontology ;
    owl:imports <https://netex-cen.eu/profile/nordic> ,
                <https://netex-cen.eu/profile/nordic-baseline> .

## Entur reuses the Nordic profile through inheritance and declares its
## additional classes with profile:scope. Nordic does not refer to this
## downstream profile.
profile:Entur a profile:Scope , nordic:Profile ;
    rdfs:label "Entur Profile" ;
    nordic:extendsProfile profile:NP .

## Entur-owned vocabulary for field-level profile declarations. The Nordic
## baseline keeps using nordic:ProfileMember; these terms describe only the
## declarations maintained by this Entur ontology.
entur:ProfileMember a owl:Class ;
    rdfs:label "ProfileMember" ;
    skos:definition "An Entur profile field (element or attribute) with its cardinality" .

entur:onClass a owl:ObjectProperty ;
    rdfs:label "onClass" ;
    rdfs:domain entur:ProfileMember ;
    rdfs:range owl:Class .

entur:element a owl:DatatypeProperty ;
    rdfs:label "element" ;
    rdfs:domain entur:ProfileMember ;
    rdfs:range xsd:string .

entur:path a owl:DatatypeProperty ;
    rdfs:label "path" ;
    rdfs:domain entur:ProfileMember ;
    rdfs:range xsd:string .

entur:cardinality a owl:DatatypeProperty ;
    rdfs:label "cardinality" ;
    rdfs:domain entur:ProfileMember ;
    rdfs:range xsd:string .

entur:Provenance a owl:Class ;
    rdfs:label "Provenance" .

entur:provenance a owl:ObjectProperty ;
    rdfs:label "provenance" ;
    rdfs:range entur:Provenance .

entur:Baseline a entur:Provenance ;
    rdfs:label "Entur baseline" ;
    skos:definition "An initial Entur profile rule not yet tracked to a separate decision" .

## These classes are additions to the effective Entur profile. Their field
## definitions are maintained here because they are not in the Nordic baseline.
netex:CompoundTrain profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:Contract profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:DatedServiceJourney profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:FareContract profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:FareZone profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:Train profile:scope profile:Entur ;
    entur:provenance entur:Baseline .
netex:TrainBlock profile:scope profile:Entur ;
    entur:provenance entur:Baseline .

## =================================================================
## ENTUR PROFILE FIELD DEFINITIONS
## =================================================================
## Field-level entur:ProfileMember data for the Entur additions above.

