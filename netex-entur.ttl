    entur:onClass netex:CompoundTrain ;
    entur:element "@id" ;
    entur:path "CompoundTrain/@id" ;
    entur:cardinality "1..1" ;
    entur:provenance entur:Baseline .
[] a entur:ProfileMember ;
    entur:onClass netex:CompoundTrain ;
    entur:element "@version" ;
    entur:path "CompoundTrain/@version" ;
