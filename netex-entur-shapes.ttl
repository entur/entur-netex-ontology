                                            sh:path <https://netex-cen.eu/ontology#@version> ] ] ;
                            sh:path netex:fareContractEntry ] ] ;
            sh:path netex:fareContractEntries ],
        [ sh:description "FareContract/@id is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "@id" ;
            sh:path <https://netex-cen.eu/ontology#@id> ],
