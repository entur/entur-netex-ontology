@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix entur: <https://entur.org/ontology#> .
@prefix netex: <https://netex-cen.eu/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entur:Authority_CardinalityShape a sh:NodeShape ;
    rdfs:label "Authority: generated from profile:cardinality" ;
    sh:property [ sh:description "Authority/CompanyNumber is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "CompanyNumber" ;
            sh:path netex:companyNumber ;
            sh:severity sh:Info ],
        [ sh:description "Authority/LegalName is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "LegalName" ;
            sh:path netex:legalName ;
            sh:severity sh:Info ] ;
    sh:targetClass netex:Authority .

entur:Block_CardinalityShape a sh:NodeShape ;
    rdfs:label "Block: generated from profile:cardinality" ;
