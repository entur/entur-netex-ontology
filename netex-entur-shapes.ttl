entur:Train_CardinalityShape a sh:NodeShape ;
    rdfs:label "Train: generated from profile:cardinality" ;
    sh:property [ sh:name "components" ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ sh:name "TrainComponent" ;
                            sh:node [ a sh:NodeShape ;
                                    sh:property [ sh:name "TrainElement" ;
                                            sh:node [ a sh:NodeShape ;
                                                    sh:property [ sh:description "Train/components/TrainComponent/TrainElement/@id is 1..1 in the profile; the XSD allows 0..1." ;
                                                            sh:minCount 1 ;
                                                            sh:name "@id" ;
                                                            sh:path <https://netex-cen.eu/ontology#@id> ] ] ;
                                            sh:path netex:trainElement ],
                                        [ sh:description "Train/components/TrainComponent/@id is 1..1 in the profile; the XSD allows 0..1." ;
                                            sh:minCount 1 ;
                                            sh:name "@id" ;
                                            sh:path <https://netex-cen.eu/ontology#@id> ],
                                        [ sh:description "Train/components/TrainComponent/@order is 1..1 in the profile; the XSD allows 0..1." ;
                                            sh:minCount 1 ;
                                            sh:name "@order" ;
                                            sh:path <https://netex-cen.eu/ontology#@order> ] ] ;
                            sh:path netex:trainComponent ] ] ;
            sh:path netex:components ],
        [ sh:description "Train/@id is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "@id" ;
            sh:path <https://netex-cen.eu/ontology#@id> ],
        [ sh:description "Train/@version is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "@version" ;
            sh:path <https://netex-cen.eu/ontology#@version> ] ;
    sh:targetClass netex:Train .

<https://entur.org/ontology/shapes> a owl:Ontology ;
    dcterms:title "../netex-entur.ttl: shapes generated from profile:cardinality" ;
    rdfs:comment "Generated by scripts/generate-shapes.py from the profile:cardinality of the members in ../netex-entur.ttl, where the profile is stricter than the XSD (docs/adr/0002). Do not hand-edit; change the membership and regenerate." ;
    prov:wasAttributedTo <https://github.com/entur/nordic-netex-ontology/blob/main/scripts/generate-shapes.py> .

