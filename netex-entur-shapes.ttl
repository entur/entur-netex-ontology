entur:DatedServiceJourney_CardinalityShape a sh:NodeShape ;
    rdfs:label "DatedServiceJourney: generated from profile:cardinality" ;
    sh:property [ sh:description "DatedServiceJourney/OperatingDayRef/@ref is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "OperatingDayRef" ;
            sh:path netex:operatingDayRef ],
        [ sh:description "DatedServiceJourney/ServiceAlteration is 0..1 in the profile; the XSD allows 0..1. Allowed values: planned, cancellation, replaced, extraJourney (the XSD allows 5)." ;
            sh:in ( "planned" "cancellation" "replaced" "extraJourney" ) ;
            sh:name "ServiceAlteration" ;
            sh:path netex:serviceAlteration ],
        [ sh:description "DatedServiceJourney/ServiceJourneyRef/@ref is 1..1 in the profile; the XSD allows 0..n." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "ServiceJourneyRef" ;
            sh:path netex:serviceJourneyRef ],
        [ sh:description "DatedServiceJourney/@id is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "@id" ;
            sh:path <https://netex-cen.eu/ontology#@id> ],
        [ sh:description "DatedServiceJourney/@version is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "@version" ;
            sh:path <https://netex-cen.eu/ontology#@version> ] ;
    sh:targetClass netex:DatedServiceJourney .

