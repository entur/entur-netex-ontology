@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix entur: <https://entur.org/ontology#> .
@prefix netex: <https://netex-cen.eu/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

entur:Block_CardinalityShape a sh:NodeShape ;
    rdfs:label "Block: generated from profile:cardinality" ;
    sh:property [ sh:description "Block/@id is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "@id" ;
            sh:path <https://netex-cen.eu/ontology#@id> ],
        [ sh:description "Block/journeys is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "journeys" ;
            sh:path netex:journeys ],
        [ sh:description "Block/@version is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "@version" ;
            sh:path <https://netex-cen.eu/ontology#@version> ] ;
    sh:targetClass netex:Block .

entur:CompositeFrame_CardinalityShape a sh:NodeShape ;
    rdfs:label "CompositeFrame: generated from profile:cardinality" ;
    sh:property [ sh:description "CompositeFrame/validityConditions is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "validityConditions" ;
            sh:path netex:validityConditions ] ;
    sh:targetClass netex:CompositeFrame .

entur:CompoundTrain_CardinalityShape a sh:NodeShape ;
    rdfs:label "CompoundTrain: generated from profile:cardinality" ;
    sh:property [ sh:description "CompoundTrain/components is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "components" ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ sh:name "TrainInCompoundTrain" ;
                            sh:node [ a sh:NodeShape ;
                                    sh:property [ sh:description "CompoundTrain/components/TrainInCompoundTrain/TrainRef/@ref is 1..1 in the profile; the XSD allows 0..1." ;
                                            sh:minCount 1 ;
                                            sh:name "TrainRef" ;
                                            sh:path netex:trainRef ],
                                        [ sh:description "CompoundTrain/components/TrainInCompoundTrain/@id is 1..1 in the profile; the XSD allows 0..1." ;
                                            sh:minCount 1 ;
                                            sh:name "@id" ;
                                            sh:path <https://netex-cen.eu/ontology#@id> ],
                                        [ sh:description "CompoundTrain/components/TrainInCompoundTrain/@order is 1..1 in the profile; the XSD allows 0..1." ;
                                            sh:minCount 1 ;
                                            sh:name "@order" ;
                                            sh:path <https://netex-cen.eu/ontology#@order> ] ] ;
                            sh:path netex:trainInCompoundTrain ] ] ;
            sh:path netex:components ],
        [ sh:description "CompoundTrain/@id is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "@id" ;
            sh:path <https://netex-cen.eu/ontology#@id> ],
        [ sh:description "CompoundTrain/@version is 1..1 in the profile; the XSD allows 0..1." ;
            sh:minCount 1 ;
            sh:name "@version" ;
            sh:path <https://netex-cen.eu/ontology#@version> ] ;
    sh:targetClass netex:CompoundTrain .

