                    sh:property [ sh:name "FareContractEntry" ;
                            sh:node [ a sh:NodeShape ;
                                    sh:property [ sh:description "FareContract/fareContractEntries/FareContractEntry/@id is 1..1 in the profile; the XSD allows 0..1." ;
                                            sh:minCount 1 ;
